# RazorRecover Backend Environment Configuration Template
# Duplicate this file to .env and configure values before starting the application.

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Database - MongoDB (Local Docker or Atlas)
MONGODB_URI=mongodb://localhost:27017/razorrecover

# Cache & Message Queue - Redis (Local Docker or Upstash)
REDIS_URL=redis://localhost:6379

# AI Configuration - Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
AI_ENABLED=true

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Policy & Execution Defaults
HIGH_VALUE_THRESHOLD_PAISE=1000000
DEFAULT_EXECUTION_MODE=MOCK_DEMO
DEMO_COMPRESSION_ENABLED=true
